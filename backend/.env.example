# MASTERYMIND AI Configuration Environment Variables

PROJECT_NAME="MASTERYMIND AI"
SECRET_KEY="replace-with-a-secure-random-secret-key-for-jwt-signing"
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# Database Configuration (SQLite default for zero-friction local run, or PostgreSQL)
DATABASE_URL="sqlite:///./masterymind.db"
# DATABASE_URL="postgresql://postgres:postgres@localhost:5432/masterymind"

# Optional AI Integration (Google Gemini)
# The application runs 100% offline with full deterministic fallback if this is empty.
GEMINI_API_KEY=""
GEMINI_MODEL="gemini-2.5-flash"

PORT=8000
